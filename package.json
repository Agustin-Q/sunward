{
  "name": "sunward",
  "version": "1.0.0",
  "description": "Solar panel tilt & direction planner: optimal orientation, monthly/daily/annual irradiance, loss analysis",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p .",
    "fixtures": "python reference/generate_fixtures.py && python reference/generate_shading_fixtures.py && python reference/generate_integration_fixtures.py",
    "artifact": "vite build && node scripts/to-artifact.mjs",
    "check": "tsc -p . && vitest run && npm run test:mandatory",
    "test:mandatory": "vitest run src/core/__tests__/integration.test.ts -t \"mandatory|buenosAires|alicante\"",
    "test:e2e": "playwright test",
    "check:all": "npm run check && npm run build && npm run test:e2e"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@yogur/solpos": "^0.1.0",
    "chart.js": "^4.5.1",
    "leaflet": "^1.9.4"
  },
  "type": "module"
}
